table Products

	partition CSV = m
		mode: import
		query:
			let
			    Source = Folder.Files(SharedDataFolder),
			    Row = Table.SelectRows(Source, each [Name] = "Products.csv"){0},
			    Csv = Csv.Document(Row[Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Headers, {
			{"Product", text},
			{"Category", text},
			{"Catalog_Price", number}
			    })
			in
			    Typed

	column Product
		dataType: string
		summarizeBy: none
		sourceColumn: Product

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column Catalog_Price
		dataType: double
		summarizeBy: none
		sourceColumn: Catalog_Price

