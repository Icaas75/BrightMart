table Date

	partition CSV = m
		mode: import
		query:
			let
			    Source = Folder.Files(SharedDataFolder),
			    Row = Table.SelectRows(Source, each [Name] = "Date.csv"){0},
			    Csv = Csv.Document(Row[Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Headers, {
			{"Date", date},
			{"Year", Int64.Type},
			{"Month", Int64.Type},
			{"MonthName", text},
			{"Day", Int64.Type},
			{"WeekdayName", text}
			    })
			in
			    Typed

	column Date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

	column Month
		dataType: int64
		summarizeBy: none
		sourceColumn: Month

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName

	column Day
		dataType: int64
		summarizeBy: none
		sourceColumn: Day

	column WeekdayName
		dataType: string
		summarizeBy: none
		sourceColumn: WeekdayName

