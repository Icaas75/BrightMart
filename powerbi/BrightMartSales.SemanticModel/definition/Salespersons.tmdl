table Salespersons

	partition CSV = m
		mode: import
		query:
			let
			    Source = Folder.Files(SharedDataFolder),
			    Row = Table.SelectRows(Source, each [Name] = "Salespersons.csv"){0},
			    Csv = Csv.Document(Row[Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Csv, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Headers, {
			{"Salesperson", text}
			    })
			in
			    Typed

	column Salesperson
		dataType: string
		summarizeBy: none
		sourceColumn: Salesperson

